# agent.md Section 2 -- environment lock. Read by src/config.py before torch import.
SEED=1234

# MPS fallback MUST be set before torch is imported (Section 2).
PYTORCH_ENABLE_MPS_FALLBACK=1

# Ollama (Section 2). KEEP_ALIVE applies during LLM phases only; GNN phases unload.
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=30m

# Model tags (verified against `ollama list` in M0).
SLM_TAG=qwen2.5:1.5b-instruct-q4_K_M
STRENGTH_TAG=qwen2.5:3b-instruct-q4_K_M
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Tokenizer parallelism off: we fork for RSS sampling.
TOKENIZERS_PARALLELISM=false
